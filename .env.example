# Environment variables for local development
# Copy this to .env and fill in values

# Relay configuration
RELAY_INFRA_PROFILE=free

# D1 Database (set by Wrangler)
# RELAY_DATABASE is automatically bound via wrangler.toml

# Durable Objects (set by Wrangler)
# RELAY_WEBSOCKET is automatically bound via wrangler.toml

# Optional: Override relay defaults
# RELAY_NAME=My Relay
# RELAY_DESCRIPTION=A general-purpose Nostr relay
# RELAY_CONTACT=admin@example.com
# RELAY_PUBKEY=your-relay-pubkey-hex

# Auth
# AUTH_REQUIRED=true
# AUTH_CHALLENGE_TIMEOUT_MS=60000

# Pay-to-relay (disabled by default)
# PAY_TO_RELAY_ENABLED=false
# RELAY_ACCESS_PRICE_SATS=21000
# RELAY_NPUB=npub1...

# Rate limiting
# EVENT_PUBLIC_RATE=30
# EVENT_GIFTWRAP_RATE=60
# REQ_RATE=60
# REQ_EXPENSIVE_RATE=10

# Database
# DB_PRUNING_ENABLED=true
# DB_SIZE_THRESHOLD_GB=4.0
# DB_PRUNE_TARGET_GB=3.5
# DB_PRUNE_BATCH_SIZE=1000

# Secrets (use `wrangler secret put` for production)
# No secrets should be stored in .env
