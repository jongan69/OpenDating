{
  "name": "opendating-protocol",
  "version": "0.1.0",
  "description": "OpenDating protocol — types, constants, validators, crypto helpers. Zero Cloudflare/Worker/D1 dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./crypto": {
      "import": "./dist/crypto/index.js",
      "types": "./dist/crypto/index.d.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nostr",
    "opendating",
    "dating",
    "protocol",
    "nip-44",
    "nip-59"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jongan69/OpenDating.git",
    "directory": "packages/protocol"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0"
  }
}
